# Copy to /opt/solar/app/deploy/cloud/cloud.env on the VM. Paths only, never secret values.
COMPOSE_PROJECT_NAME=solar
SOLAR_PORT=8080
SOLAR_IMAGE_TAG=local
SOLAR_DB_SECRET=/opt/solar/secrets/database-password
SOLAR_SETUP_SECRET=/opt/solar/secrets/setup-password
SUNGROW_APP_SECRET=/opt/solar/secrets/sungrow-app.json
SUNGROW_MAPPING_SECRET=/opt/solar/secrets/sungrow-mapping.json
TS_ENV_FILE=/opt/solar/secrets/tailscale.env
TS_HOSTNAME=solar
SUNGROW_DEFAULT_ZONE=Europe/Berlin
